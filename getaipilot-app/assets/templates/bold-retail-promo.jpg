<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <!-- Diagonal Gold Hatch Pattern -->
    <pattern id="br-hatch" width="10" height="10" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="10" stroke="#d4c33d" stroke-width="3.8" />
    </pattern>
    <filter id="br-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Environment Background -->
  <rect width="400" height="500" fill="#08221a"/>

  <!-- Card Body -->
  <rect x="40" y="24" width="320" height="440" rx="20" fill="#0e372b" stroke="#000" stroke-opacity="0.3" stroke-width="1.5" filter="url(#br-shadow)"/>

  <!-- Top Main Headline -->
  <text x="200" y="78" fill="#ffffff" font-family="'Impact', 'Arial Black', sans-serif" font-size="34" font-weight="900" text-anchor="middle" letter-spacing="1">SCAN HERE</text>
  <text x="200" y="96" fill="#e2f5ee" font-family="system-ui, sans-serif" font-size="10.5" font-weight="800" text-anchor="middle" letter-spacing="2">TO SEE OUR BEST PRODUCTS</text>

  <!-- Center Diagonal Hatch Circles -->
  <!-- Top-Right Hatch Circle -->
  <circle cx="280" cy="190" r="50" fill="url(#br-hatch)"/>
  <!-- Bottom-Left Hatch Circle -->
  <circle cx="120" cy="285" r="50" fill="url(#br-hatch)"/>

  <!-- QR Frame Card (Dark badge with solid white border) -->
  <g filter="url(#br-shadow)">
    <rect x="110" y="148" width="180" height="180" rx="22" fill="#09271e" stroke="#ffffff" stroke-width="3"/>
    
    <!-- Inner QR White Backing -->
    <rect x="122" y="160" width="156" height="156" rx="14" fill="#ffffff"/>

    <!-- Simulated QR Finder Patterns -->
    <rect x="134" y="172" width="32" height="32" fill="#0e372b" rx="5"/>
    <rect x="138" y="176" width="24" height="24" fill="#ffffff" rx="3"/>
    <rect x="142" y="180" width="16" height="16" fill="#0e372b" rx="2"/>

    <rect x="234" y="172" width="32" height="32" fill="#0e372b" rx="5"/>
    <rect x="238" y="176" width="24" height="24" fill="#ffffff" rx="3"/>
    <rect x="242" y="180" width="16" height="16" fill="#0e372b" rx="2"/>

    <rect x="134" y="272" width="32" height="32" fill="#0e372b" rx="5"/>
    <rect x="138" y="276" width="24" height="24" fill="#ffffff" rx="3"/>
    <rect x="142" y="280" width="16" height="16" fill="#0e372b" rx="2"/>

    <!-- Bit Matrix Blocks -->
    <rect x="180" y="174" width="7" height="18" fill="#0e372b" rx="1"/>
    <rect x="196" y="178" width="18" height="7" fill="#0e372b" rx="1"/>
    <rect x="174" y="200" width="12" height="12" fill="#0e372b" rx="1"/>
    <rect x="216" y="200" width="9" height="9" fill="#0e372b" rx="1"/>
    <rect x="190" y="266" width="16" height="7" fill="#0e372b" rx="1"/>
    <rect x="220" y="258" width="9" height="18" fill="#0e372b" rx="1"/>
    <rect x="242" y="232" width="18" height="7" fill="#0e372b" rx="1"/>
    <rect x="142" y="232" width="14" height="7" fill="#0e372b" rx="1"/>

    <!-- Central Logo Badge -->
    <circle cx="200" cy="238" r="18" fill="#0e372b" stroke="#ffffff" stroke-width="2.5"/>
    <text x="200" y="244" fill="#d4c33d" font-family="system-ui, sans-serif" font-size="14" font-weight="900" text-anchor="middle">@</text>
  </g>

  <!-- Bottom Section -->
  <!-- Left Discount Text -->
  <text x="65" y="388" fill="#ffffff" font-family="'Impact', 'Arial Black', sans-serif" font-size="16" font-weight="900" letter-spacing="0.5">GET DISCOUNT UP</text>
  <text x="65" y="408" fill="#ffffff" font-family="'Impact', 'Arial Black', sans-serif" font-size="16" font-weight="900" letter-spacing="0.5">TO 50% OFF!</text>

  <!-- Right Divider Line + Arrow + Website -->
  <line x1="225" y1="395" x2="310" y2="395" stroke="#ffffff" stroke-width="1.8" opacity="0.4"/>
  <circle cx="325" cy="395" r="9" fill="#d4c33d" fill-opacity="0.2" stroke="#d4c33d" stroke-width="1.2"/>
  <path d="M 322 393 L 325 397 L 328 393" stroke="#d4c33d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>

  <text x="334" y="415" fill="#e2f5ee" font-family="system-ui, sans-serif" font-size="10" font-weight="700" text-anchor="end">www.getaipilot.in</text>
</svg>