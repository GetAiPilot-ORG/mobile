<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <!-- Dark Void Obsidian Glass Gradient -->
    <linearGradient id="ch-void" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0b1022"/>
      <stop offset="50%" stop-color="#050814"/>
      <stop offset="100%" stop-color="#020308"/>
    </linearGradient>

    <!-- Electric Prismatic Laser Rim Gradient -->
    <linearGradient id="ch-laser-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#00f0ff"/>
      <stop offset="30%" stop-color="#3b82f6"/>
      <stop offset="65%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#ec4899"/>
    </linearGradient>

    <!-- Titanium Base Gradient -->
    <linearGradient id="ch-base" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1e1b4b"/>
      <stop offset="45%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#030712"/>
    </linearGradient>

    <!-- Intense Hologram Glow Filter -->
    <filter id="ch-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <filter id="ch-drop" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="18" flood-color="#00f0ff" flood-opacity="0.3"/>
    </filter>
  </defs>

  <!-- Deep Tech Void Background -->
  <rect width="400" height="500" fill="#03050c"/>

  <!-- Matrix HUD Telemetry Grid -->
  <g opacity="0.18" stroke="#00f0ff" stroke-width="0.8">
    <line x1="40" y1="0" x2="40" y2="500" stroke-dasharray="2,6"/>
    <line x1="200" y1="0" x2="200" y2="500" stroke-dasharray="1,5"/>
    <line x1="360" y1="0" x2="360" y2="500" stroke-dasharray="2,6"/>
    <line x1="0" y1="110" x2="400" y2="110" stroke-dasharray="4,8"/>
    <line x1="0" y1="360" x2="400" y2="360" stroke-dasharray="4,8"/>
  </g>

  <!-- Glowing Cyan Ambient Halo -->
  <circle cx="200" cy="220" r="140" fill="#00f0ff" opacity="0.08" filter="url(#ch-glow)"/>

  <!-- Floating Chamfered Hex Glass HUD Plaque (45° Cyber Chamfer Silhouette) -->
  <g filter="url(#ch-drop)">
    <!-- Outer Glowing Prismatic Rim (Chamfered Tech Corners) -->
    <polygon points="68,20 332,20 358,46 358,424 332,450 68,450 42,424 42,46"
             fill="none" stroke="url(#ch-laser-rim)" stroke-width="2.5"/>

    <!-- Dark Obsidian Glass Body -->
    <polygon points="70,22 330,22 356,48 356,422 330,448 70,448 44,422 44,48"
             fill="url(#ch-void)" fill-opacity="0.94"/>

    <!-- Diagonal Holographic Glare Sheen -->
    <path d="M 44 140 L 220 22 L 250 22 L 44 190 Z" fill="#ffffff" opacity="0.06"/>
  </g>

  <!-- HUD Corner Telemetry Tickers -->
  <text x="64" y="38" fill="#00f0ff" font-family="monospace" font-size="7.5" font-weight="900" letter-spacing="1.5">◰ SYS.HUD // LIVE</text>
  <text x="336" y="38" fill="#ec4899" font-family="monospace" font-size="7.5" font-weight="900" text-anchor="end" letter-spacing="1.5">NODE.01 ◱</text>

  <!-- Top Protocol Status Badge -->
  <rect x="110" y="44" width="180" height="17" rx="8.5" fill="#0f172a" stroke="url(#ch-laser-rim)" stroke-width="1.2"/>
  <circle cx="124" cy="52.5" r="2.8" fill="#10b981" filter="url(#ch-glow)"/>
  <text x="204" y="55.5" fill="#a5f3fc" font-family="system-ui, monospace" font-size="7.5" font-weight="900" text-anchor="middle" letter-spacing="1.5">AR-SYNCED // LIVE PROTOCOL</text>

  <!-- 3D Holographic Wireframe Quantum Node -->
  <g transform="translate(200, 92)">
    <!-- Wireframe Octahedron -->
    <polygon points="0,-22 22,-4 0,18 -22,-4" stroke="#00f0ff" stroke-width="1.8" fill="rgba(0,240,255,0.1)"/>
    <polygon points="0,-22 22,-4 0,-1" stroke="#38bdf8" stroke-width="1.2" fill="rgba(59,130,246,0.2)"/>
    <polygon points="0,-22 -22,-4 0,-1" stroke="#818cf8" stroke-width="1.2" fill="rgba(129,140,248,0.2)"/>
    <polygon points="0,18 22,-4 0,-1" stroke="#c084fc" stroke-width="1.2" fill="rgba(192,132,252,0.25)"/>
    <polygon points="0,18 -22,-4 0,-1" stroke="#f472b6" stroke-width="1.2" fill="rgba(244,114,182,0.25)"/>
    <!-- Center Core -->
    <circle cx="0" cy="-2" r="4.5" fill="#00f0ff" opacity="0.5"/>
    <circle cx="0" cy="-2" r="2" fill="#ffffff"/>
    <!-- Orbital Rings -->
    <ellipse cx="0" cy="-2" rx="34" ry="12" fill="none" stroke="#00f0ff" stroke-width="0.8" stroke-dasharray="4,4" opacity="0.6"/>
  </g>

  <!-- Project Title & HUD Coordinate -->
  <text x="200" y="130" fill="#ffffff" font-family="system-ui, sans-serif" font-size="14.5" font-weight="900" text-anchor="middle" letter-spacing="2.5">QUANTUM // OS 2.0</text>
  <text x="200" y="144" fill="#38bdf8" font-family="monospace" font-size="7.8" font-weight="700" text-anchor="middle" letter-spacing="1.2">SYS.GRID // 47.6062° N, 122.3321° W</text>

  <!-- Mid-Card Telemetry Spec Strip -->
  <g transform="translate(80, 152)">
    <rect x="0" y="0" width="240" height="15" rx="4" fill="#000" fill-opacity="0.5" stroke="#00f0ff" stroke-width="0.6"/>
    <text x="36" y="10.5" fill="#38bdf8" font-family="monospace" font-size="6.8" font-weight="800">⚡ 60 FPS</text>
    <line x1="72" y1="2" x2="72" y2="13" stroke="#00f0ff" stroke-width="0.5" opacity="0.4"/>
    <text x="120" y="10.5" fill="#a5f3fc" font-family="monospace" font-size="6.8" font-weight="700" text-anchor="middle">FREQ: 5.8 GHz</text>
    <line x1="168" y1="2" x2="168" y2="13" stroke="#00f0ff" stroke-width="0.5" opacity="0.4"/>
    <text x="204" y="10.5" fill="#34d399" font-family="monospace" font-size="6.8" font-weight="800" text-anchor="middle">SPATIAL AR</text>
  </g>

  <!-- Holographic Target Reticle & QR Unit -->
  <g>
    <!-- Outer HUD Corner Targeting Brackets -->
    <g stroke="#00f0ff" stroke-width="2.5" fill="none">
      <!-- Top Left -->
      <path d="M 112 188 L 112 174 L 126 174"/>
      <!-- Top Right -->
      <path d="M 288 188 L 288 174 L 274 174"/>
      <!-- Bottom Left -->
      <path d="M 112 324 L 112 338 L 126 338"/>
      <!-- Bottom Right -->
      <path d="M 288 324 L 288 338 L 274 338"/>
    </g>

    <!-- Laser Scanning Beam across top of QR -->
    <line x1="126" y1="174" x2="274" y2="174" stroke="#00f0ff" stroke-width="2"/>

    <!-- High-Contrast Optical White QR Card with Electric Cyan Border -->
    <rect x="120" y="178" width="160" height="160" rx="18" fill="#ffffff" stroke="#00f0ff" stroke-width="2" filter="url(#ch-drop)"/>

    <!-- Simulated QR Finder Patterns (Crisp Deep Cyber Navy #060c1d) -->
    <rect x="136" y="194" width="30" height="30" fill="#060c1d" rx="5"/>
    <rect x="140" y="198" width="22" height="22" fill="#ffffff" rx="3"/>
    <rect x="144" y="202" width="14" height="14" fill="#060c1d" rx="2"/>

    <rect x="234" y="194" width="30" height="30" fill="#060c1d" rx="5"/>
    <rect x="238" y="198" width="22" height="22" fill="#ffffff" rx="3"/>
    <rect x="242" y="202" width="14" height="14" fill="#060c1d" rx="2"/>

    <rect x="136" y="292" width="30" height="30" fill="#060c1d" rx="5"/>
    <rect x="140" y="296" width="22" height="22" fill="#ffffff" rx="3"/>
    <rect x="144" y="300" width="14" height="14" fill="#060c1d" rx="2"/>

    <!-- Cyber Matrix Modules -->
    <rect x="180" y="196" width="6" height="16" fill="#060c1d" rx="1"/>
    <rect x="194" y="200" width="16" height="6" fill="#060c1d" rx="1"/>
    <rect x="174" y="220" width="10" height="10" fill="#060c1d" rx="1"/>
    <rect x="216" y="220" width="8" height="8" fill="#060c1d" rx="1"/>
    <rect x="190" y="284" width="14" height="6" fill="#060c1d" rx="1"/>
    <rect x="220" y="276" width="8" height="16" fill="#060c1d" rx="1"/>
    <rect x="242" y="252" width="16" height="6" fill="#060c1d" rx="1"/>
    <rect x="142" y="252" width="12" height="6" fill="#060c1d" rx="1"/>

    <!-- Center Prismatic Logo Core -->
    <circle cx="200" cy="258" r="17" fill="#060c1d" stroke="#00f0ff" stroke-width="2.5"/>
    <circle cx="200" cy="258" r="13" fill="#00f0ff" fill-opacity="0.15"/>
    <text x="200" y="263" fill="#00f0ff" font-family="system-ui, sans-serif" font-size="12" font-weight="900" text-anchor="middle">@</text>
  </g>

  <!-- AR CTA Text -->
  <text x="200" y="360" fill="#ffffff" font-family="monospace" font-size="9.5" font-weight="900" text-anchor="middle" letter-spacing="1.5">SCAN TO ACCESS AR INTERFACE</text>
  <text x="200" y="373" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="7.5" font-weight="600" text-anchor="middle">Interactive 3D Spatial Node &amp; Developer Beta</text>

  <!-- Quantum Secure Badge -->
  <rect x="136" y="388" width="128" height="20" rx="10" fill="#1e1b4b" stroke="#818cf8" stroke-width="1"/>
  <text x="200" y="401" fill="#c7d2fe" font-family="system-ui, sans-serif" font-size="7.5" font-weight="900" text-anchor="middle" letter-spacing="1">⚡ QUANTUM SECURE</text>

  <!-- System Ticker Line -->
  <line x1="62" y1="418" x2="338" y2="418" stroke="#00f0ff" stroke-width="0.8" opacity="0.3"/>
  <text x="70" y="430" fill="#64748b" font-family="monospace" font-size="7">NODE_STATUS: ONLINE</text>
  <text x="330" y="430" fill="#00f0ff" font-family="monospace" font-size="7" text-anchor="end">FPS: 60 // AR LINKED</text>

  <!-- Titanium Base Laser Dock -->
  <polygon points="100,458 300,458 320,474 80,474" fill="url(#ch-base)" stroke="#00f0ff" stroke-width="1.2"/>
  <!-- Glowing Laser Slit projecting upward light -->
  <line x1="120" y1="463" x2="280" y2="463" stroke="#00f0ff" stroke-width="2.5" filter="url(#ch-glow)"/>
  <ellipse cx="200" cy="484" rx="120" ry="8" fill="#00f0ff" opacity="0.25" filter="url(#ch-glow)"/>
</svg>