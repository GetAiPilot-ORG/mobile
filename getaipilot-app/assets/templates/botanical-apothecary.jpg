<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <!-- Emerald Sage Gradient -->
    <linearGradient id="ba-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#182e22"/>
      <stop offset="50%" stop-color="#0f2017"/>
      <stop offset="100%" stop-color="#07130c"/>
    </linearGradient>

    <!-- Antique Gold Foil Gradient -->
    <linearGradient id="ba-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#c9a767"/>
      <stop offset="50%" stop-color="#f7e1b5"/>
      <stop offset="100%" stop-color="#8c6a2c"/>
    </linearGradient>

    <!-- Carrara Marble Pedestal Gradient -->
    <linearGradient id="ba-marble" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#c2cfc6"/>
      <stop offset="50%" stop-color="#e8f0ec"/>
      <stop offset="100%" stop-color="#9cb0a2"/>
    </linearGradient>

    <filter id="ba-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#000" flood-opacity="0.8"/>
    </filter>
  </defs>

  <!-- Deep Environment Background -->
  <rect width="400" height="500" fill="#080e0a"/>

  <!-- Main Arched Plaque Body -->
  <g filter="url(#ba-shadow)">
    <!-- Arched Silhouette -->
    <path d="M 44 140 C 44 45, 356 45, 356 140 L 356 440 C 356 450, 348 458, 338 458 L 62 458 C 52 458, 44 450, 44 440 Z" fill="url(#ba-bg)" stroke="#c9a767" stroke-width="2.5"/>
    
    <!-- Inner Filigree Pinstripe -->
    <path d="M 52 140 C 52 53, 348 53, 348 140 L 348 432 C 348 440, 342 448, 332 448 L 68 448 C 58 448, 52 440, 52 432 Z" fill="none" stroke="#dfc38d" stroke-width="0.9" opacity="0.45"/>
  </g>

  <!-- Botanical Eucalyptus & Lavender Sprig Artwork -->
  <g transform="translate(200, 76)">
    <!-- Main Center Stem -->
    <path d="M 0 38 Q 2 15 0 -22" stroke="url(#ba-gold)" stroke-width="2.2" stroke-linecap="round"/>
    
    <!-- Left Leaves -->
    <path d="M 0 28 C -14 26, -18 16, -10 12 C -2 15, 0 22, 0 28 Z" fill="url(#ba-gold)" opacity="0.9"/>
    <path d="M 0 12 C -15 10, -18 -2, -9 -6 C -2 -2, 0 6, 0 12 Z" fill="url(#ba-gold)" opacity="0.9"/>
    <path d="M 0 -4 C -12 -6, -15 -16, -7 -18 C -1 -16, 0 -8, 0 -4 Z" fill="url(#ba-gold)" opacity="0.95"/>

    <!-- Right Leaves -->
    <path d="M 0 20 C 14 18, 18 8, 10 4 C 2 7, 0 14, 0 20 Z" fill="url(#ba-gold)" opacity="0.9"/>
    <path d="M 0 4 C 15 2, 18 -10, 9 -14 C 2 -10, 0 -2, 0 4 Z" fill="url(#ba-gold)" opacity="0.9"/>

    <!-- Top Bud -->
    <circle cx="0" cy="-22" r="2.5" fill="#f7e1b5"/>
  </g>

  <!-- Batch & Heritage Line -->
  <text x="200" y="126" fill="#f7e1b5" font-family="system-ui, sans-serif" font-size="7.5" font-weight="800" text-anchor="middle" letter-spacing="2">BATCH NO. 84 • EST. 1928</text>

  <!-- Brand Title & Concept -->
  <text x="200" y="146" fill="#fffaf0" font-family="Georgia, serif" font-size="14" font-weight="900" text-anchor="middle" letter-spacing="3">ST. CLAIR BOTANICALS</text>
  <text x="200" y="159" fill="#c2d7cb" font-family="system-ui, sans-serif" font-size="8" font-weight="600" text-anchor="middle" letter-spacing="1">ORGANIC HERBAL APOTHECARY &amp; SPA</text>

  <!-- Wax Seal Badge -->
  <g transform="translate(200, 172)">
    <rect x="-65" y="-9" width="130" height="18" rx="9" fill="#0b3820" stroke="#c9a767" stroke-width="1"/>
    <circle cx="-52" cy="0" r="3" fill="#c9a767"/>
    <text x="4" y="3" fill="#fae5be" font-family="system-ui, sans-serif" font-size="7.5" font-weight="900" text-anchor="middle" letter-spacing="1.5">100% BOTANICAL</text>
  </g>

  <!-- Ingredients Ribbon -->
  <rect x="58" y="190" width="284" height="20" rx="10" fill="#06120b" stroke="#c9a767" stroke-width="0.8" opacity="0.9"/>
  <text x="200" y="203" fill="#fae5be" font-family="system-ui, sans-serif" font-size="7.5" font-weight="600" text-anchor="middle">Wild French Lavender • Cold-Pressed Jojoba • Chamomile</text>

  <!-- Scannable Artisan QR Code Frame -->
  <g>
    <!-- Parchment Backing -->
    <rect x="120" y="220" width="160" height="160" rx="18" fill="#fbf9f4" stroke="#c9a767" stroke-width="2.5" filter="url(#ba-shadow)"/>
    <rect x="126" y="226" width="148" height="148" rx="14" fill="none" stroke="#dfc38d" stroke-width="0.8"/>

    <!-- Simulated QR Finder Patterns (Deep Forest Tone) -->
    <rect x="136" y="236" width="30" height="30" fill="#0b2014" rx="5"/>
    <rect x="140" y="240" width="22" height="22" fill="#fbf9f4" rx="3"/>
    <rect x="144" y="244" width="14" height="14" fill="#0b2014" rx="2"/>

    <rect x="234" y="236" width="30" height="30" fill="#0b2014" rx="5"/>
    <rect x="238" y="240" width="22" height="22" fill="#fbf9f4" rx="3"/>
    <rect x="242" y="244" width="14" height="14" fill="#0b2014" rx="2"/>

    <rect x="136" y="334" width="30" height="30" fill="#0b2014" rx="5"/>
    <rect x="140" y="338" width="22" height="22" fill="#fbf9f4" rx="3"/>
    <rect x="144" y="342" width="14" height="14" fill="#0b2014" rx="2"/>

    <!-- Fine Matrix Blocks -->
    <rect x="180" y="238" width="6" height="16" fill="#0b2014" rx="1"/>
    <rect x="194" y="242" width="16" height="6" fill="#0b2014" rx="1"/>
    <rect x="174" y="262" width="10" height="10" fill="#0b2014" rx="1"/>
    <rect x="216" y="262" width="8" height="8" fill="#0b2014" rx="1"/>
    <rect x="190" y="326" width="14" height="6" fill="#0b2014" rx="1"/>
    <rect x="220" y="318" width="8" height="16" fill="#0b2014" rx="1"/>
    <rect x="242" y="294" width="16" height="6" fill="#0b2014" rx="1"/>
    <rect x="142" y="294" width="12" height="6" fill="#0b2014" rx="1"/>

    <!-- Center Logo Badge -->
    <circle cx="200" cy="300" r="17" fill="#c9a767" stroke="#fbf9f4" stroke-width="2.5"/>
    <circle cx="200" cy="300" r="13" fill="#0b2014"/>
    <text x="200" y="305" fill="#f7e1b5" font-family="system-ui, sans-serif" font-size="12" font-weight="900" text-anchor="middle">@</text>
  </g>

  <!-- CTA Banner -->
  <text x="200" y="400" fill="#fffaf0" font-family="Georgia, serif" font-size="10" font-weight="900" text-anchor="middle" letter-spacing="1.5">SCAN FOR ELIXIR &amp; SPA RITUAL MENU</text>
  <text x="200" y="413" fill="#c2d7cb" font-family="system-ui, sans-serif" font-size="7.5" font-weight="500" text-anchor="middle">Handcrafted herbal infusions, aromatherapy rituals &amp; treatments</text>

  <!-- Footer Ribbon -->
  <line x1="60" y1="426" x2="340" y2="426" stroke="#c9a767" stroke-width="0.8" opacity="0.4"/>
  <text x="70" y="439" fill="#f7e1b5" font-family="system-ui, sans-serif" font-size="7.5" font-weight="800">★ APOTHECARY VERIFIED</text>
  <text x="330" y="439" fill="#34d399" font-family="system-ui, sans-serif" font-size="7.5" font-weight="800" text-anchor="end">GUEST WI-FI CONNECTED</text>

  <!-- Carrara Marble Pedestal -->
  <rect x="100" y="464" width="200" height="16" rx="4" fill="url(#ba-marble)" stroke="#74877b" stroke-width="1"/>
  <ellipse cx="200" cy="482" rx="110" ry="6" fill="#000" opacity="0.45"/>
</svg>