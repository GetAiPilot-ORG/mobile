<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <filter id="cwm-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#000" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Environment Background -->
  <rect width="400" height="500" fill="#f1f5f9"/>

  <!-- Card Body -->
  <g filter="url(#cwm-shadow)">
    <rect x="44" y="24" width="312" height="442" rx="22" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
    
    <!-- Upper Teal Canopy with Concave Wave Bottom -->
    <path d="M 44 46 C 44 33.85, 53.85 24, 66 24 L 334 24 C 346.15 24, 356 33.85, 356 46 L 356 320 C 270 345, 130 345, 44 320 Z" fill="#148a9d"/>
  </g>

  <!-- Header Typography (White on Teal) -->
  <text x="200" y="72" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="34" font-weight="900" text-anchor="middle" letter-spacing="2">E-MENU</text>
  <text x="200" y="92" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10.5" font-weight="600" text-anchor="middle" opacity="0.95">For a contactless menu, scan QR code</text>

  <!-- White QR Card in Teal Section -->
  <g filter="url(#cwm-shadow)">
    <rect x="115" y="116" width="170" height="170" rx="16" fill="#ffffff"/>

    <!-- Simulated QR Finder Patterns (Teal Tone) -->
    <rect x="130" y="131" width="32" height="32" fill="#148a9d" rx="4"/>
    <rect x="134" y="135" width="24" height="24" fill="#ffffff" rx="2"/>
    <rect x="138" y="139" width="16" height="16" fill="#148a9d" rx="1"/>

    <rect x="238" y="131" width="32" height="32" fill="#148a9d" rx="4"/>
    <rect x="242" y="135" width="24" height="24" fill="#ffffff" rx="2"/>
    <rect x="246" y="139" width="16" height="16" fill="#148a9d" rx="1"/>

    <rect x="130" y="239" width="32" height="32" fill="#148a9d" rx="4"/>
    <rect x="134" y="243" width="24" height="24" fill="#ffffff" rx="2"/>
    <rect x="138" y="247" width="16" height="16" fill="#148a9d" rx="1"/>

    <!-- Bit Matrix Blocks -->
    <rect x="175" y="133" width="7" height="18" fill="#148a9d" rx="1"/>
    <rect x="192" y="137" width="18" height="7" fill="#148a9d" rx="1"/>
    <rect x="170" y="160" width="12" height="12" fill="#148a9d" rx="1"/>
    <rect x="218" y="160" width="9" height="9" fill="#148a9d" rx="1"/>
    <rect x="188" y="234" width="16" height="7" fill="#148a9d" rx="1"/>
    <rect x="222" y="226" width="9" height="18" fill="#148a9d" rx="1"/>
    <rect x="244" y="200" width="18" height="7" fill="#148a9d" rx="1"/>
    <rect x="138" y="200" width="14" height="7" fill="#148a9d" rx="1"/>

    <!-- Central Logo Badge -->
    <circle cx="200" cy="201" r="18" fill="#148a9d" stroke="#ffffff" stroke-width="2.5"/>
    <text x="200" y="207" fill="#ffffff" font-family="system-ui, sans-serif" font-size="14" font-weight="900" text-anchor="middle">@</text>
  </g>

  <!-- Lower White Section -->
  <!-- Dashed Logo Placeholder Box -->
  <rect x="176" y="356" width="48" height="44" rx="4" fill="none" stroke="#64748b" stroke-width="1.2" stroke-dasharray="3,3"/>
  <text x="200" y="373" fill="#334155" font-family="system-ui, sans-serif" font-size="8.5" font-weight="900" text-anchor="middle" letter-spacing="1">YOUR</text>
  <text x="200" y="386" fill="#334155" font-family="system-ui, sans-serif" font-size="9" font-weight="900" text-anchor="middle" letter-spacing="1">LOGO</text>

  <!-- Headline & Subtext -->
  <text x="200" y="422" fill="#148a9d" font-family="system-ui, sans-serif" font-size="14" font-weight="900" text-anchor="middle" letter-spacing="1">QR MENU DESCRIPTION</text>
  <text x="200" y="438" fill="#475569" font-family="system-ui, sans-serif" font-size="9" font-weight="600" text-anchor="middle">More comfortable, faster and environmentally friendly.</text>
</svg>