{
  "expo": {
    "name": "GetAIPilot",
    "slug": "getaipilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logobag.webp",
    "scheme": "getaipilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getaipilot",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow GetAIPilot to use Face ID for fast and secure authentication.",
        "NSMicrophoneUsageDescription": "Allow GetAIPilot to access your microphone to record voice notes and convert speech to text.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "message",
          "googlegmail",
          "ms-outlook",
          "ymail"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.webp",
        "backgroundImage": "./assets/images/android-icon-background.webp",
        "monochromeImage": "./assets/images/android-icon-monochrome.webp"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.getaipilot",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.webp"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.webp",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow GetAIPilot to use Face ID for fast and secure authentication."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logobag.webp",
          "color": "#DEA5A4",
          "largeIcon": "./assets/images/logo-white-bg.webp"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "08c04d39-4b19-437c-ba60-bac94d475279"
      }
    },
    "owner": "priyansh.dev"
  }
}
