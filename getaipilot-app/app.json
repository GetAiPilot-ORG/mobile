{
  "expo": {
    "name": "GetAIPilot",
    "slug": "getaipilot",
    "owner": "poojareactnative",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getaipilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unreala9.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow GetAIPilot to use Face ID for fast and secure authentication.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "androidNavigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.unreala9.mobile",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "barStyle": "dark"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow GetAIPilot to use Face ID for fast and secure authentication."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b20e09aa-b2a4-483d-ba57-6b1b70f6d988"
      },
      "router": {}
    }
  }
}